config_version=5

[application]

config/name="Not Task Bar Hero"
config/description="O maior RPG idle minúsculo! Adoráveis heróis em pixel estão prontos para embarcar na aventura ao seu lado — direto da sua barra de tarefas. Derrote o tédio do trabalho e do dia a dia com classes, habilidades, itens e builds variados! Você pode ter visto essa descrição em algum lugar. Mas tenha certeza que esse Não é o mesmo jogo."
